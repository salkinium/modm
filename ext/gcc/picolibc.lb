def init(module):
    module.name = ":stdc:picolibc"
    module.description = """
# Picolibc

[Picolibc](https://github.com/picolibc/picolibc) is library offering standard C
library APIs that targets small embedded systems with limited RAM.
"""


def prepare(module, options):
    core = options[":target"].get_driver("core")["type"]
    return core.startswith("cortex-m")


def build(env):
    core = env[":target"].get_driver("core")["type"]
    env.outbasepath = "modm/ext/gcc/picolibc"
    env.collect(":build:path.include", "modm/ext/gcc/picolibc")

    env.copy("picolibc/newlib/libc/", "libc", ignore=env.ignore_files("machine"))
