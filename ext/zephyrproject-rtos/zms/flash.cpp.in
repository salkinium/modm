#include "zms.hpp"
#include <modm/platform/flash/flash.hpp>
#include <zephyr/drivers/flash.h>
#include <algorithm>

using modm::platform::Flash;

namespace
{

int
read(const device *, off_t offset, void *data, size_t size)
{
	// A word with a double ECC error is copied anyway, the CRCs of ZMS reject it
	(void) Flash::read(Flash::OriginAddr + offset, data, size);
	return 0;
}

int
write(const device *, off_t offset, const void *data, size_t size)
{
	// The buffer program refuses targets that are not erased and skips units of
	// only erased bytes, which some STM32 could not program again afterwards
	if (not Flash::unlock()) return -EIO;
	const uint32_t error = Flash::program(Flash::OriginAddr + offset, data, size);
	Flash::lock();
	return error ? -EIO : 0;
}

int
erase(const device *, off_t offset, size_t size)
{
	if (not Flash::unlock()) return -EIO;
	uint32_t error{};
	for (uint16_t page = Flash::getPage(offset); page <= Flash::getPage(offset + size - 1) and not error; page++)
		error = Flash::erase(page);
	Flash::lock();
	return error ? -EIO : 0;
}

const flash_parameters parameters{Flash::WriteSize, {0}, Flash::ErasedValue};

const flash_parameters *
get_parameters(const device *)
{ return &parameters; }

int
get_page_info(const device *, off_t offset, flash_pages_info *info)
{
	const uint16_t page = Flash::getPage(offset);
	info->start_offset = Flash::getOffset(page);
	info->size = Flash::getSize(page);
	info->index = page;
	return 0;
}

const flash_driver_api api{read, write, erase, get_parameters, get_page_info};
const device dev{&api, nullptr};

}	// namespace

const struct device *
modm::zms::flash()
{ return &dev; }

bool
modm::zms::setup(zms_fs &fs, uint32_t offset, uint32_t sector_count, uint32_t min_sector_size)
{
	const uint16_t first = Flash::getPage(offset);
	const size_t page_size = Flash::getSize(first);
	const uint32_t pages = (std::max<size_t>(min_sector_size, page_size) + page_size - 1) / page_size;
	for (uint16_t page = first; page < first + pages * sector_count; page++)
		if (Flash::getSize(page) != page_size or Flash::getOffset(page) != offset + (page - first) * page_size)
			return false;
	fs = {};
	fs.flash_device = &dev;
	fs.offset = offset;
	fs.sector_size = pages * page_size;
	fs.sector_count = sector_count;
	return true;
}
