def init(module):
    module.name = ":driver:cs43l22"
    module.description = "CS43L22 Audio DAC (control port registers)"

def prepare(module, options):
    module.depends(":architecture:i2c.device")
    return True

def build(env):
    env.outbasepath = "modm/src/modm/driver/audio"
    env.copy("cs43l22.hpp")
