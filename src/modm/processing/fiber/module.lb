def init(module):
    module.name = ":processing:fiber"
    module.description = FileReader("module.md")

def prepare(module, options):
    module.depends(":architecture:clock", ":architecture:atomic",
                   ":architecture:assert", ":architecture:fiber", ":stdc++")

    core = options[":target"].get_driver("core")["type"]
    if core.startswith("cortex-m"): module.depends(":cmsis:device")
    module.add_option(
        BooleanOption(name="thread_local", default=False,
                      description=descr_thread_local))
    return (core.startswith("cortex-m") or core.startswith("avr") or
            "x86_64" in core or "arm64" in core)


def build(env):
    env.outbasepath = "modm/src/modm/processing"
    env.copy("../fiber.hpp", "fiber.hpp")

    env.outbasepath = "modm/src/modm/processing/fiber"
    core = env[":target"].get_driver("core")["type"]
    with_fpu = env.get(":platform:cortex-m:float-abi", "soft") != "soft"
    env.substitutions = {
        "is_cm0": core.startswith("cortex-m0"),
        "is_avr": core.startswith("avr"),
        "is_windows": env[":target"].identifier.family == "windows",
        "is_darwin": env[":target"].identifier.family == "darwin",
        "with_psplim": core.startswith("cortex-m") and sum(c.isnumeric() for c in core) == 2,
        "core": core,
        "with_fpu": with_fpu,
        "target": env[":target"].identifier,
        "multicore": env.has_module(":platform:multicore"),
        "with_tls": env.get("thread_local", False),
        "with_emutls": False,
        "num_cores": 1,
    }
    if env.substitutions["with_tls"] and ("x86_64" in core or "arm64" in core):
        # Fibers can only have their own TLS with emulated TLS on hosted, which
        # GCC only uses on Darwin, while Clang can be forced to use it.
        compiler = env.get(":build:compiler", "gcc")
        if compiler == "clang":
            env.collect(":build:ccflags", "-femulated-tls")
        elif env[":target"].identifier.family != "darwin":
            env.substitutions["with_tls"] = False
        if env.substitutions["with_tls"]:
            env.substitutions["with_emutls"] = True
            env.copy("tls_hosted.cpp")
    env.substitutions["with_emutls"] |= env.substitutions["with_tls"] and core.startswith("avr")
    if env.has_module(":platform:multicore"):
        cores = int(env[":target"].identifier.cores)
        env.substitutions["num_cores"] = cores

    if core.startswith("cortex-m"):
        env.substitutions["stack_minimum"] = (2 + 9 + (16 if with_fpu else 0)) * 4
        env.substitutions["default_stack_size"] = 1024
        env.template("context_arm_m.cpp.in")

    elif core.startswith("avr"):
        env.substitutions["stack_minimum"] = 4 + 18 + 6 # -2 if PC only 2B
        env.substitutions["default_stack_size"] = 512
        env.copy("context_avr.cpp")
        if env.get("thread_local", False):
            env.copy("tls_avr.cpp")
            # Sorting groups the TLS control objects in .data, see tls_avr.cpp
            env.collect(":build:linkflags", "-Wl,--sort-section=name")

    elif "x86_64" in core:
        env.substitutions["stack_minimum"] = (30 + 2) * 8
        env.substitutions["default_stack_size"] = 2**20 # 1MB
        env.template("context_x86_64.cpp.in")

    elif "arm64" in core:
        env.substitutions["stack_minimum"] = (20 + 2) * 8
        env.substitutions["default_stack_size"] = 2**20 # 1MB
        env.copy("context_arm64.cpp")

    env.template("context.h")
    env.template("stack.hpp.in")
    env.template("scheduler.hpp.in")
    env.copy("scheduler.cpp")
    env.template("task.hpp.in")
    env.template("task_impl.hpp.in")


descr_thread_local = """# Thread-local storage per fiber

Gives each fiber its own copy of all `thread_local` variables.

The destructors of `thread_local` objects are never called, so only use
trivially destructible types. See the module documentation for all limitations.

On AVR, GCC limits each variable to 255 bytes and the linker must sort all
input sections by name.

On hosted targets, fibers use emulated TLS, which GCC only supports on Darwin,
while Clang is forced to use it with `-femulated-tls`. With GCC on Linux and
Windows, all fibers share the `thread_local` variables of their thread.
"""
