def init(module):
    module.name = ":communication:cyphal"
    module.description = FileReader("module.md")

def prepare(module, options):
    module.depends(
        ":libcanard",
        ":o1heap",
        ":architecture:can",
        ":architecture:clock")
    # o1heap is only available on Cortex-M
    return options[":target"].has_driver("core:cortex-m*")

def build(env):
    env.outbasepath = "modm/src/modm/communication/cyphal"
    env.copy("node.hpp")
    if env.has_module(":dronecan"):
        env.copy("dronecan.hpp")
    env.copy("../cyphal.hpp")
