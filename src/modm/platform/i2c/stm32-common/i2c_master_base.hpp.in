#pragma once
#include <modm/architecture/interface/i2c_master.hpp>
#include <modm/architecture/interface/i2c_transaction.hpp>
#include <modm/platform/device.hpp>
#include <cstddef>
#include <cstdint>

#ifdef MODM_I2C_TRACE
/**
 * Called for every step of the controller state machine with the state before, the
 * flag that ended it (or a pseudo flag for software steps), the action taken and the
 * state after. Off by default; to record the steps, for example to replay them on the
 * peripheral models, name a function with `modm:build:cppdefines` as
 * `MODM_I2C_TRACE=my_trace` and define `void my_trace(uint8_t, uint8_t, uint8_t, uint8_t)`.
 */
void MODM_I2C_TRACE(uint8_t before, uint8_t flag, uint8_t action, uint8_t after);
#endif

namespace modm::platform
{

/**
 * The I2C controller driver shared by all instances of the
%% if extended
 * NBYTES/RELOAD/AUTOEND peripheral (I2C v2).
%% else
 * SB/ADDR/BTF peripheral (I2C v1).
%% endif
 *
 * It implements modm::I2cMaster on the peripheral at `peripheral`, the static
 * `I2cMasterN` classes forward to one object of it each. The state machine was
 * derived from the reference manual and errata models and stress tested on
 * hardware, the states carry the names of these models.
 *
 * @ingroup	modm_platform_i2c
 */
class I2cMasterBase : public ::modm::I2c
{
public:
	using Error = ::modm::I2cMaster::Error;

	struct Entry
	{
		I2cTransaction *transaction;
		ConfigurationHandler configuration;
	};

	/// @param	peripheral	the address of the I2C registers
	/// @param	queue		storage for the transactions waiting for the bus
	constexpr I2cMasterBase(uintptr_t peripheral, Entry *queue, uint16_t capacity) :
		peripheral(peripheral), queue(queue), capacity(capacity) {}

	/// Attaches the transaction and starts it, or queues it while the bus is in use.
	bool
	start(I2cTransaction *transaction, ConfigurationHandler handler = nullptr);

	/// Ends the transfer with a STOP after the current byte, detaches the current and all
	/// queued transactions, resets the peripheral and clears the bus with `recoverBus`
	/// if a device still holds it. Busy waits up to 4 ms; not from an interrupt.
	void
	reset();

	Error
	getErrorState() const
	{ return error; }

	/// A transaction is attached or its transfer still runs.
	bool
	busy() const
	{ return active or transaction; }

	/// The interrupt handler of the event and error interrupts.
	void
	isr();

%% if extended
	/// Disables the peripheral and sets the timing register.
	void
	configure(uint32_t timingRegister);

#ifdef I2C_TIMEOUTR_TIMOUTEN
	/// Sets the SMBus bus timeout to `ticks` of 2048 I2CCLK (1..4096), 0 disables it.
	void
	setTimeout(uint16_t ticks);
#endif
%% else
	/// Disables the peripheral and sets the clock registers.
	void
	configure(uint8_t peripheralFrequencyMHz, uint8_t riseTime, uint16_t clockControl);
%% endif

	/// Clears a bus that a device holds, see I2c::clearBus(), `true` after a read was cut
	/// off. Called by reset() and when the bus is still busy at a START.
	void (*recoverBus)(bool afterRead) = nullptr;

	/// Bytes per NBYTES chunk on v2 (1..255), smaller values force RELOAD. For tests only.
	uint8_t maxChunk = 255;

public:
	// state machine, with the names of the peripheral model
%% if extended
	enum class
	State : uint8_t
	{ Idle, Addr, Tx, TxWait, RxAck, Rx, TcWait, ReloadTx, ReloadRx, Stopping, Disabled };
	enum
	Flag : uint8_t
	{ TXIS = 1, RXNE = 2, NACKF = 4, STOPF = 5, TC = 6, TCR = 7, BERR = 8, ARLO = 9, TIMEOUT = 12 };
	enum class
	Action : uint8_t
	{ None, Start, Write, Read, Next, Reload, Done, Nack, Berr, Arlo, Reset, Unexpected, Stop };
%% else
	enum class
	State : uint8_t
	{ Idle, SbWait, Addr, Tx, TxBtf, Rx, RxBtf, RxEnd, AfWait, Stopping, Corrupt, BusyOther, Disabled, RxPos };
	enum
	Flag : uint8_t
	{ SB = 0, ADDR = 1, BTF = 2, RXNE = 6, TXE = 7, BERR = 8, ARLO = 9, AF = 10 };
	enum class
	Action : uint8_t
	{
		None, Start, Address, ClearTx, Write, Read, Wait, Late, Extra, Nack, Berr, Arlo, Reset, Unexpected,
		ClearPingP, ClearPingSr, ClearRx1P, ClearRx1Sr, EndTxP, EndTxSr, ReadEndP, ReadEndSr, BtfEndP, BtfEndSr,
		ReadLastP, ReadLastSr, ClearRx, BtfPosP, BtfPosSr, ClearRxPos
	};
%% endif
	/// pseudo flags of the software steps
	enum : uint8_t { START = 16, POLL = 17, DEADLINE = 18, BUSY_AT_START = 19 };

private:
	I2C_TypeDef *
	regs() const
	{ return reinterpret_cast<I2C_TypeDef *>(peripheral); }

	void begin();
	bool segment(I2cTransaction::Starting starting);
	bool fetch(Operation op);
	void unexpected(uint8_t flag);
	void refuse();
	void detach(DetachCause cause);
	void hwReset();
	bool busBusy() const;
%% if extended
	uint32_t chunk();
	void stop(State before, uint8_t flag);
%% else
	bool more();
	void finishSegment();
	void end(bool stop);
	void buffer(bool on);
%% endif

	void
	go(State before, uint8_t flag, Action action, State after)
	{
#ifdef MODM_I2C_TRACE
		::MODM_I2C_TRACE(uint8_t(before), flag, uint8_t(action), uint8_t(after));
#else
		(void) before; (void) flag; (void) action;
#endif
		state = after;
	}

	const uintptr_t peripheral;
	Entry *const queue;
	const uint16_t capacity;
	uint16_t head{0}, count{0};

	I2cTransaction *volatile transaction{nullptr};
	ConfigurationHandler configuration{nullptr};

	// the current buffer, fetched before its START
	uint8_t address{0};
	bool reading{false};
	size_t length{0}, index{0};
	uint8_t *rbuf{nullptr};
	const uint8_t *wbuf{nullptr};
	Operation next{Operation::Stop};	///< after this buffer: Stop, Restart or Write (no Sr)

	volatile bool active{false};
	volatile State state{State::Idle};
	volatile Error error{Error::NoError};
%% if extended
	size_t planned{0};	///< bytes of the buffer programmed into NBYTES so far
	uint32_t timingr{0};
%% else
	uint8_t freq{0}, trise{0};
	uint16_t ccr{0};
%% endif
};

} // namespace modm::platform
