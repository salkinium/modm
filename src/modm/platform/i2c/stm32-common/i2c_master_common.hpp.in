#pragma once
#include <modm/architecture/interface/i2c_bus.hpp>
#include <modm/architecture/interface/i2c_transfer.hpp>
#include <modm/architecture/interface/i2c_transaction.hpp>
#include <modm/platform/device.hpp>
#include <cstddef>
#include <cstdint>

#ifdef MODM_I2C_TRACE
/**
 * Called for every step of the controller state machine with the state before, the
 * flag that ended it (or a pseudo flag for software steps), the action taken and the
 * state after. Off by default; to record the steps, for example to replay them on the
 * peripheral models, name a function with `modm:build:cppdefines` as
 * `MODM_I2C_TRACE=my_trace` and define `void my_trace(uint8_t, uint8_t, uint8_t, uint8_t)`.
 */
void MODM_I2C_TRACE(uint8_t before, uint8_t flag, uint8_t action, uint8_t after);
#endif

#ifdef MODM_I2C_PROFILE
/// Cycle profile of the interrupt path (measurement builds only, cppdefine MODM_I2C_PROFILE):
/// every scope adds its own cycles, without those of the scopes it calls, in interrupt context.
namespace modm::platform::i2c_profile
{
enum : uint8_t { Other, Isr, Starting, Fetch, Finish, NextData, DataDone, InterpFinish,
				 TStarting, TWriting, TReading, TDetaching, TakeNext, Continue, NextGlue, Count };
inline constexpr const char *names[Count] = {"other", "isr", "starting", "fetch", "finish",
	"nextData", "dataDone", "interpFinish", "t.starting", "t.writing", "t.reading", "t.detaching",
	"takeNext", "continue", "nextGlue"};
inline uint32_t cycles[Count], calls[Count];
inline uint8_t stack[8], depth;
inline uint32_t mark;
inline void reset() { for (auto &c : cycles) c = 0; for (auto &c : calls) c = 0; depth = 0; }
struct Scope
{
	const bool on;
	Scope(uint8_t id) : on(__get_IPSR() != 0)
	{
		if (not on) return;
		cycles[stack[depth]] += DWT->CYCCNT - mark;
		stack[++depth] = id; calls[id]++;
		mark = DWT->CYCCNT;
	}
	~Scope()
	{
		if (not on) return;
		cycles[stack[depth--]] += DWT->CYCCNT - mark;
		mark = DWT->CYCCNT;
	}
};
}	// namespace modm::platform::i2c_profile
#define MODM_I2C_PROFILE_SCOPE(id) ::modm::platform::i2c_profile::Scope modm_i2c_profile_scope{::modm::platform::i2c_profile::id}
#else
#define MODM_I2C_PROFILE_SCOPE(id)
#endif

namespace modm::platform
{

/// One step of the I2C controller state machine, see I2cMasterBase::State, Flag, Action.
/// @ingroup	modm_platform_i2c
struct I2cStep
{
	uint8_t before;	///< I2cMasterBase::State
	uint8_t flag;	///< I2cMasterBase::Flag, or a pseudo flag of I2cMasterCommon
	uint8_t action;	///< I2cMasterBase::Action
	uint8_t after;	///< I2cMasterBase::State
};

/**
 * The last `Size` steps of the state machine in a ring buffer, frozen at the first
 * failure: a transfer that ends with an error other than an address NACK (which also
 * means absent or busy), or a reset(). The steps up to the failure stay for inspection until resume().
 * Enabled with the `modm:platform:i2c:recorder` option (number of steps).
 *
 * @ingroup	modm_platform_i2c
 */
template< size_t N >
class I2cStepRecorder
{
public:
	static constexpr size_t Size = N;

	/// Steps recorded, at most Size.
	size_t
	size() const
	{ return (count < N) ? count : N; }

	/// The steps, oldest first.
	I2cStep
	operator[](size_t ii) const
	{ return steps[(count < N) ? ii : (count + ii) % N]; }

	/// A failure froze the recording.
	bool
	isFrozen() const
	{ return frozen; }

	/// Clears the steps and records again.
	void
	resume()
	{ count = 0; frozen = false; }

	void
	add(I2cStep step)
	{ if (not frozen) steps[count++ % N] = step; }

	void
	freeze()
	{ frozen = true; }

private:
	I2cStep steps[N]{};
	volatile size_t count{0};
	volatile bool frozen{false};
};

template<>
class I2cStepRecorder<0>
{
public:
	static constexpr size_t Size = 0;
	size_t size() const { return 0; }
	I2cStep operator[](size_t) const { return {}; }
	bool isFrozen() const { return false; }
	void resume() {}
	void add(I2cStep) {}
	void freeze() {}
};

/**
 * The part of the STM32 I2C controller driver that does not depend on the peripheral
 * version: the transaction queue, attaching and detaching, fetching the buffers, and
 * recording the steps. I2cMasterBase adds the state machine of the peripheral.
 *
 * @ingroup	modm_platform_i2c
 */
class I2cMasterCommon : public ::modm::I2cBus
{
public:
	/// @param	peripheral	the address of the I2C registers
	constexpr I2cMasterCommon(uintptr_t peripheral) : peripheral(peripheral) {}

	Error
	getErrorState() const final
	{ return error; }

	size_t
	getErrorIndex() const final
	{ return errorIndex; }

	/// A transaction or transfer is attached or its bus traffic still runs.
	bool
	busy() const
	{ return active or transaction or client; }

	/// Clears a bus that a device holds, see I2c::clearBus(), `true` after a read was cut
	/// off. Called by reset() and when the bus is still busy at a START.
	void (*recoverBus)(bool afterRead) = nullptr;

	/// The last steps of the state machine, frozen at the first failure.
	I2cStepRecorder<{{ recorder }}> recorder;

	/// pseudo flags of the software steps
	enum : uint8_t { START = 16, POLL = 17, DEADLINE = 18, BUSY_AT_START = 19 };

protected:
	enum class
	Attach : uint8_t { Refused, Queued, Now };

	/// Attaches the transaction, call with interrupts locked.
	Attach
	attach(I2cTransaction *transaction, ConfigurationHandler handler);

	/// Attaches the transfer (bound and begun by I2cTransferBase), interrupts locked.
	Attach
	attach(I2cTransferBase &transfer);

	/// What follows a START: the next segment's address and direction, from the attached
	/// transaction or transfer (OperationAfterStart::End: nothing, STOP now).
	I2cTransaction::Starting
	starting();

	/// Detaches the current transaction and attaches the next queued one: `true` if it
	/// is to begin now.
	bool
	finish(DetachCause cause);

	/// Detaches the queued and the current transactions after a reset.
	void
	detachAll();

	/// The next buffer: op is what the transaction said follows (Read, Write or Stop for
	/// a ping). `false` for a read of length 0, which is refused.
	bool
	fetch(Operation op);

	// a transfer's segments: the interpreter runs in the driver
	bool nextData(bool busHeld);
	bool nextOther(const xfer::Segment *segment, bool busHeld);
	void doneData();
	bool continueTransfer(DetachCause cause);
	bool takeNext();
	static xfer::Error map(Error error);

	void
	trace(uint8_t before, uint8_t flag, uint8_t action, uint8_t after)
	{
#ifdef MODM_I2C_TRACE
		::MODM_I2C_TRACE(before, flag, action, after);
#endif
		recorder.add({before, flag, action, after});
	}

	I2C_TypeDef *
	regs() const
	{ return reinterpret_cast<I2C_TypeDef *>(peripheral); }

	/// Sets the error and its byte position (`index`, less the bytes still waiting in the
	/// transmit register when a target refused one).
	void
	fail(Error e, size_t pending = 0)
	{
		error = e;
		errorIndex = (index >= pending) ? index - pending : 0;
	}

	const uintptr_t peripheral;
	I2cTransaction *queueHead{nullptr}, *queueTail{nullptr};	///< intrusive, through I2cTransaction::queueNext
	I2cTransferBase *xferHead{nullptr}, *xferTail{nullptr};	///< intrusive, through I2cTransferBase::queueNext
	bool preferTransfer{false};	///< the next client from the transfer queue, when both wait

	I2cTransaction *volatile transaction{nullptr};
	I2cTransferBase *volatile client{nullptr};	///< the attached transfer (or a transaction)
	const xfer::Segment *seg{nullptr};	///< the transfer's current data segment (prepared, or scratch)
	xfer::Segment scratch{};	///< the interpreter's segment when it is not prepared
	bool served{false};		///< its buffer was handed to the state machine
	bool prefetched{false};	///< seg was fetched when the previous attach ended (p, polling)
	ConfigurationHandler configuration{nullptr};

	// the current buffer, fetched before its START
	uint8_t address{0};
	bool reading{false};
	size_t length{0}, index{0};
	uint8_t *rbuf{nullptr};
	const uint8_t *wbuf{nullptr};
	Operation next{Operation::Stop};	///< after this buffer: Stop, Restart or Write (no Sr)

	volatile bool active{false};
	volatile Error error{Error::NoError};
	size_t errorIndex{0};
};

} // namespace modm::platform
