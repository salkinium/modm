#include "i2c_master_base.hpp"
#include <modm/architecture/interface/atomic_lock.hpp>
#include <modm/architecture/interface/delay.hpp>
#include <algorithm>

// The state machine follows the peripheral models and was stress tested on hardware
// (DISCO-F469NI for v1, DISCO-F303VC for v2) with random interrupt latency. Rules
// that came out of it, each one a failure that was measured without it:
//  - every buffer is fetched before its START, so its length and the operation after
//    it decide the read method (v1) or NBYTES/RELOAD/AUTOEND (v2) up front,
//  - a read of length 0 is refused: before the START if it is the first segment, else
//    the bus still ends with a STOP and the transfer fails with Error::Unknown,
//  - the transaction is detached when its STOP is requested (v1) or done (v2).

namespace modm::platform
{

bool
I2cMasterBase::start(I2cTransaction *t, ConfigurationHandler handler)
{
	if (not t) return false;
	modm::atomic::Lock lock;
	if (count >= capacity or not t->attaching())
	{
		t->detaching(DetachCause::FailedToAttach);
		return false;
	}
	if (transaction or active)
	{
		queue[(head + count++) % capacity] = {t, handler};
		return true;
	}
	if (handler and handler != configuration) { configuration = handler; handler(); }
	transaction = t;
	begin();
	return true;
}

void
I2cMasterBase::reset()
{
	I2C_TypeDef *const r = regs();
	bool afterRead;
	{
		modm::atomic::Lock lock;
		afterRead = active and reading;
		if (active)
		{
			// A STOP after the current byte, with the interrupts off: a device cut off in
			// the middle of a byte may not reset on START or STOP and take the next
			// transfer's bits as data (measured with a CS43L22, which then wrote them
			// into its registers).
%% if extended
			r->CR1 = I2C_CR1_PE;
			r->CR2 = (r->CR2 & ~(I2C_CR2_RELOAD | I2C_CR2_START)) | I2C_CR2_STOP;
%% else
			r->CR2 &= ~(I2C_CR2_ITEVTEN | I2C_CR2_ITBUFEN | I2C_CR2_ITERREN);
			r->CR1 = (r->CR1 & ~(I2C_CR1_ACK | I2C_CR1_POS | I2C_CR1_START)) | I2C_CR1_STOP;
%% endif
		}
	}
	// at most a few bytes at 10 kHz
	for (int us = 0; us < 4000 and busBusy(); us += 10)
	{
%% if not extended
		if (r->SR1 & I2C_SR1_RXNE) (void) r->DR;	// a full receiver holds SCL
%% endif
		modm::delay_us(10);
	}
	const bool stuck = busBusy();
	{
		modm::atomic::Lock lock;
		go(state, DEADLINE, Action::Reset, State::Idle);
		hwReset();
		error = Error::SoftwareReset;
		for (; count; count--, head = (head + 1) % capacity)
			queue[head].transaction->detaching(DetachCause::ErrorCondition);
		active = false;
		if (I2cTransaction *t = transaction)
		{
			transaction = nullptr;
			t->detaching(DetachCause::ErrorCondition);
		}
	}
	// a device still holds the bus: clear it, outside the lock
	if (stuck and recoverBus) { recoverBus(afterRead); hwReset(); }
}

bool
I2cMasterBase::busBusy() const
{
%% if extended
	return regs()->ISR & I2C_ISR_BUSY;
%% else
	return regs()->SR2 & I2C_SR2_BUSY;
%% endif
}

// ends the transfer and starts the next queued one
void
I2cMasterBase::detach(DetachCause cause)
{
	active = false;
	I2cTransaction *t = transaction;
	transaction = nullptr;
	if (t) t->detaching(cause);	// may call start() again
	if (transaction or not count) return;
	const Entry e = queue[head];
	head = (head + 1) % capacity; count--;
	if (e.configuration and e.configuration != configuration) { configuration = e.configuration; e.configuration(); }
	transaction = e.transaction;
	begin();
}

// the next buffer: op is what the transaction said follows (Read, Write or Stop for a ping)
bool
I2cMasterBase::fetch(Operation op)
{
	index = 0;
%% if extended
	planned = 0;
%% endif
	if (op == Operation::Read)
	{
		const auto r = transaction->reading();
		reading = true; rbuf = r.buffer; length = r.length; next = Operation(r.next);
		return length > 0;	// a read of nothing is refused
	}
	reading = false;
	if (op == Operation::Write)
	{
		const auto w = transaction->writing();
		wbuf = w.buffer; length = w.length; next = Operation(w.next);
	}
	else { wbuf = nullptr; length = 0; next = Operation::Stop; }
	return true;
}

void
I2cMasterBase::unexpected(uint8_t flag)
{
	go(state, flag, Action::Unexpected, State::Idle);
	hwReset();
	error = Error::Unknown;
	detach(DetachCause::ErrorCondition);
}

%% if extended
// ---- v2: NBYTES/RELOAD/AUTOEND ----------------------------------------------------

void
I2cMasterBase::configure(uint32_t timingRegister)
{
	timingr = timingRegister;
	regs()->CR1 = 0;
	regs()->OAR1 = 0;
	regs()->OAR2 = 0;
	hwReset();
}

#ifdef I2C_TIMEOUTR_TIMOUTEN
void
I2cMasterBase::setTimeout(uint16_t ticks)
{
	// TIMEOUTEN must be cleared before the reload value is changed
	regs()->TIMEOUTR = 0;
	if (ticks) regs()->TIMEOUTR = I2C_TIMEOUTR_TIMOUTEN | I2C_TIMEOUTR_TEXTEN |
			(ticks - 1) | ((ticks - 1) << I2C_TIMEOUTR_TIMEOUTB_Pos);
}
#endif

void
I2cMasterBase::hwReset()
{
	// PE must stay low for three APB clock cycles, the reads ensure that
	regs()->CR1 = 0;
	for (int ii = 0; ii < 3; ii++) (void) regs()->CR1;
	regs()->TIMINGR = timingr;
	regs()->CR1 = I2C_CR1_PE | I2C_CR1_ERRIE;
	state = State::Idle;
}

void
I2cMasterBase::isr()
{
	I2C_TypeDef *const r = regs();
	const uint32_t isr = r->ISR;
	const State before = state;
	if (not active)
	{
		r->ICR = I2C_ICR_NACKCF | I2C_ICR_STOPCF | I2C_ICR_BERRCF | I2C_ICR_ARLOCF | I2C_ICR_OVRCF;
#ifdef I2C_ICR_TIMOUTCF
		r->ICR = I2C_ICR_TIMOUTCF;
#endif
		return;
	}
	if (isr & I2C_ISR_NACKF)
	{
		// the STOP follows automatically
		error = (before == State::Addr) ? Error::AddressNack : Error::DataNack;
		r->ICR = I2C_ICR_NACKCF;
		r->ISR = I2C_ISR_TXE;
		go(before, NACKF, Action::Nack, State::Stopping);
	}
	else if (isr & I2C_ISR_BERR)
	{
		error = Error::BusCondition;
		r->ICR = I2C_ICR_BERRCF;
		go(before, BERR, Action::Berr, before);
	}
	else if (isr & I2C_ISR_ARLO)
	{
		r->ICR = I2C_ICR_ARLOCF;
		go(before, ARLO, Action::Arlo, State::Idle);
		error = Error::ArbitrationLost;
		detach(DetachCause::ErrorCondition);
	}
#ifdef I2C_ISR_TIMEOUT
	else if (isr & I2C_ISR_TIMEOUT)
	{
		// the SMBus bus timeout of setTimeout(): SCL held low too long
		r->ICR = I2C_ICR_TIMOUTCF;
		go(before, TIMEOUT, Action::Unexpected, State::Idle);
		hwReset();
		error = Error::BusCondition;
		detach(DetachCause::ErrorCondition);
	}
#endif
	else if (isr & I2C_ISR_RXNE)
	{
		if (not reading or index >= length) return unexpected(RXNE);
		rbuf[index++] = r->RXDR;
		go(before, RXNE, Action::Read, State::RxAck);
	}
	else if (isr & I2C_ISR_TXIS)
	{
		if (reading or index >= length) return unexpected(TXIS);
		r->TXDR = wbuf[index++];
		go(before, TXIS, Action::Write, State::Tx);
	}
	else if (isr & I2C_ISR_TCR)
	{
		// A read with a byte of the chunk unread: the chunk's last byte arrived while RXDR
		// was still full; it is acknowledged and TCR set, but it never reaches RXDR and no
		// RXNE comes, and after a reload SCL stays low for good (measured on STM32F303,
		// about once per 100k reloads with interrupt latency, not in ES0204). The byte is
		// lost, so the transfer ends here instead of hanging.
		if (reading and index < planned) return unexpected(TCR);
		if (planned >= length)
		{
			// a write that goes on in the next buffer; empty buffers are skipped
			if (next != Operation::Write) return unexpected(TCR);
			while (next == Operation::Write) { fetch(Operation::Write); if (length) break; }
			if (not length)
			{
				// Only empty buffers followed. RM0316 does not say what STOP/START do while
				// TCR is set; measured on STM32F303: STOP is sent, START is taken as a
				// reload. So STOP now, or NBYTES = 0 without RELOAD, which sets TC, and the
				// repeated START from there.
				if (next == Operation::Stop)
				{
					r->CR2 = (r->CR2 & ~(I2C_CR2_NBYTES | I2C_CR2_RELOAD | I2C_CR2_AUTOEND | I2C_CR2_START)) |
							 I2C_CR2_STOP;
					return go(before, TCR, Action::Stop, State::Stopping);
				}
				r->CR2 = r->CR2 & ~(I2C_CR2_NBYTES | I2C_CR2_RELOAD | I2C_CR2_AUTOEND | I2C_CR2_START | I2C_CR2_STOP);
				return go(before, TCR, Action::Reload, State::TcWait);
			}
		}
		r->CR2 = (r->CR2 & ~(I2C_CR2_NBYTES | I2C_CR2_RELOAD | I2C_CR2_AUTOEND | I2C_CR2_START | I2C_CR2_STOP)) |
				 chunk();
		go(before, TCR, Action::Reload, reading ? State::Rx : State::TxWait);
	}
	else if (isr & I2C_ISR_TC)
	{
		if (next != Operation::Restart) return unexpected(TC);
		if (not segment(transaction->starting())) return stop(before, TC);
		go(before, TC, Action::Next, State::Addr);
	}
	else if (isr & I2C_ISR_STOPF)
	{
		r->ICR = I2C_ICR_STOPCF;
		r->ISR = I2C_ISR_TXE;
		go(before, STOPF, Action::Done, State::Idle);
		detach((error == Error::NoError) ? DetachCause::NormalStop : DetachCause::ErrorCondition);
	}
}

void
I2cMasterBase::begin()
{
	I2C_TypeDef *const r = regs();
	active = true;
	error = Error::NoError;
	if (r->ISR & I2C_ISR_BUSY)
	{
		// the previous transfer's STOP or another controller: wait up to 1 ms, then reset
		for (int us = 0; us < 1000 and (r->ISR & I2C_ISR_BUSY); us++) modm::delay_us(1);
		if (r->ISR & I2C_ISR_BUSY)
		{
			// a device holds the bus: a peripheral reset, then the bus clear (busy waits)
			hwReset();
			if ((r->ISR & I2C_ISR_BUSY) and recoverBus) { recoverBus(false); hwReset(); }
			go(State::Idle, BUSY_AT_START, Action::Reset, State::Idle);
			if (r->ISR & I2C_ISR_BUSY) { error = Error::BusBusy; return detach(DetachCause::ErrorCondition); }
		}
	}
	go(State::Idle, START, Action::Start, State::Addr);
	r->CR1 = I2C_CR1_PE | I2C_CR1_ERRIE | I2C_CR1_TCIE | I2C_CR1_STOPIE | I2C_CR1_NACKIE | I2C_CR1_RXIE | I2C_CR1_TXIE;
	if (not segment(transaction->starting())) refuse();
}

// fetches the segment that follows a START and sends the START
bool
I2cMasterBase::segment(I2cTransaction::Starting s)
{
	address = s.address;
	if (not fetch(Operation(s.next))) return false;
	// empty buffers before anything is sent carry no data and are skipped: NBYTES = 0 with
	// RELOAD at START sets TC, not TCR (measured on STM32F303)
	while (not reading and not length and next == Operation::Write) fetch(Operation::Write);
	regs()->CR2 = (uint32_t(address) & 0xfe) | (reading ? I2C_CR2_RD_WRN : 0) | chunk() | I2C_CR2_START;
	return true;
}

uint32_t
I2cMasterBase::chunk()
{
	const size_t n = std::min<size_t>(length - planned, maxChunk);
	planned += n;
	uint32_t cr2 = uint32_t(n) << I2C_CR2_NBYTES_Pos;
	if (planned < length or next == Operation::Write) cr2 |= I2C_CR2_RELOAD;
	else if (next == Operation::Stop) cr2 |= I2C_CR2_AUTOEND;
	return cr2;
}

// the next segment is refused while the bus is held after TC: STOP, the transfer fails
void
I2cMasterBase::stop(State before, uint8_t flag)
{
	error = Error::Unknown;
	regs()->CR2 = (regs()->CR2 & ~(I2C_CR2_NBYTES | I2C_CR2_RELOAD | I2C_CR2_AUTOEND | I2C_CR2_START)) | I2C_CR2_STOP;
	go(before, flag, Action::Stop, State::Stopping);
}

// the first segment is refused, before its START
void
I2cMasterBase::refuse()
{
	go(state, START, Action::Unexpected, State::Idle);
	error = Error::Unknown;
	regs()->CR1 = I2C_CR1_PE | I2C_CR1_ERRIE;
	detach(DetachCause::ErrorCondition);
}

%% else
// ---- v1: SB/ADDR/BTF ----------------------------------------------------------------

void
I2cMasterBase::configure(uint8_t peripheralFrequencyMHz, uint8_t riseTime, uint16_t clockControl)
{
	freq = peripheralFrequencyMHz;
	trise = riseTime;
	ccr = clockControl;
	hwReset();
}

// SWRST, then CR2/CCR/TRISE again: the reset clears them
void
I2cMasterBase::hwReset()
{
	regs()->CR1 = I2C_CR1_SWRST;
	regs()->CR1 = 0;
	regs()->CR2 = freq;
	regs()->CCR = ccr;
	regs()->TRISE = trise;
	regs()->CR1 = I2C_CR1_PE;
	state = State::Idle;
}

void
I2cMasterBase::end(bool stop)
{ regs()->CR1 |= stop ? I2C_CR1_STOP : I2C_CR1_START; }

void
I2cMasterBase::buffer(bool on)
{
	if (on) regs()->CR2 |= I2C_CR2_ITBUFEN;
	else regs()->CR2 &= ~I2C_CR2_ITBUFEN;
}

void
I2cMasterBase::isr()
{
	I2C_TypeDef *const r = regs();
	const uint32_t sr1 = r->SR1;
	const bool buf = r->CR2 & I2C_CR2_ITBUFEN;
	const State before = state;
	const bool last = next == Operation::Stop;
	const uint8_t sr = last ? 0 : 1;

	if (buf and (sr1 & I2C_SR1_RXNE))
	{
		if (state == State::Stopping)
		{
			// a byte after the last one, the transaction is already detached
			(void) r->DR;
			buffer(false);
			return go(before, RXNE, Action::Extra, State::Stopping);
		}
		if (not active) { (void) r->DR; return; }
		if (state == State::RxEnd)
		{
			const uint8_t b = r->DR;
			if (index < length) rbuf[index++] = b;
			buffer(last);
			go(before, RXNE, Action(uint8_t(Action::ReadLastP) + sr), last ? State::Stopping : State::SbWait);
			return finishSegment();
		}
		if (state != State::Rx) return unexpected(RXNE);
		const size_t remaining = length - index;
		if (remaining > 3) { rbuf[index++] = r->DR; return go(before, RXNE, Action::Read, State::Rx); }
		if (remaining == 3) { buffer(false); return go(before, RXNE, Action::Wait, State::Rx); }
		return unexpected(RXNE);
	}
	if (sr1 & I2C_SR1_SB)
	{
		if (state != State::SbWait) return unexpected(SB);
		r->DR = address | (reading ? 1 : 0);
		if (reading and length > 1) r->CR1 |= I2C_CR1_ACK;
		return go(before, SB, Action::Address, State::Addr);
	}
	if (sr1 & I2C_SR1_ADDR)
	{
		if (state != State::Addr) return unexpected(ADDR);
		if (reading and length == 1)
		{
			// EV6_1: ACK = 0 before the ADDR clear, STOP/START right after it, with
			// interrupts off, so that it is set before the byte ends
			__disable_irq();
			r->CR1 &= ~I2C_CR1_ACK;
			(void) r->SR1; (void) r->SR2;
			end(last);
			__enable_irq();
			buffer(true);
			return go(before, ADDR, Action(uint8_t(Action::ClearRx1P) + sr), State::RxEnd);
		}
		if (reading and length == 2)
		{
			// POS method for two bytes: POS = 1 makes ACK act on the next byte, ACK = 0
			// right after the ADDR clear while SCL is stretched, so the first byte is
			// acknowledged and the second NACKed whatever the interrupt latency, then BTF
			// holds both. Method 1 (ACK clear after the first RXNE) is not latency proof.
			__disable_irq();
			r->CR1 |= I2C_CR1_POS | I2C_CR1_ACK;
			(void) r->SR1; (void) r->SR2;
			r->CR1 &= ~I2C_CR1_ACK;
			__enable_irq();
			buffer(false);
			return go(before, ADDR, Action::ClearRxPos, State::RxPos);
		}
		(void) r->SR1; (void) r->SR2;
		if (reading) { buffer(true); return go(before, ADDR, Action::ClearRx, State::Rx); }
		if (not length and not more())
		{
			// a ping, or only empty write buffers
			const bool stop = next == Operation::Stop;
			end(stop); buffer(false);
			go(before, ADDR, Action(uint8_t(Action::ClearPingP) + (stop ? 0 : 1)), stop ? State::Stopping : State::SbWait);
			return finishSegment();
		}
		r->DR = wbuf[index++];
		buffer(index < length or next == Operation::Write);
		return go(before, ADDR, Action::ClearTx, State::Tx);
	}
	if (sr1 & I2C_SR1_AF)
	{
		error = (state == State::Addr) ? Error::AddressNack : Error::DataNack;
		r->SR1 = ~I2C_SR1_AF;
		r->CR1 |= I2C_CR1_STOP;
		buffer(false);
		go(before, AF, Action::Nack, State::Stopping);
		return detach(DetachCause::ErrorCondition);
	}
	if (sr1 & I2C_SR1_BERR)
	{
		error = Error::BusCondition;
		r->SR1 = ~I2C_SR1_BERR;
		return go(before, BERR, Action::Berr, before);
	}
	if (sr1 & I2C_SR1_ARLO)
	{
		r->SR1 = ~I2C_SR1_ARLO;
		buffer(false);
		go(before, ARLO, Action::Arlo, State::BusyOther);
		error = Error::ArbitrationLost;
		return detach(DetachCause::ErrorCondition);
	}
	// BTF stays set after STOP/START is programmed at BTF until the condition is on the
	// bus, it is stale in SbWait and Stopping
	if ((sr1 & I2C_SR1_BTF) and state != State::SbWait and state != State::Stopping and active)
	{
		if (state == State::RxPos)
		{
			// POS: both bytes in, the second NACKed. POS is cleared in the same write that
			// sets STOP/START: a CR1 read-modify-write after the DR reads can land after the
			// hardware cleared START/STOP and set it again (a second START with no address,
			// or a second STOP that breaks the next START).
			r->CR1 = (r->CR1 & ~I2C_CR1_POS) | (last ? I2C_CR1_STOP : I2C_CR1_START);
			rbuf[index++] = r->DR;
			rbuf[index++] = r->DR;
			go(before, BTF, Action(uint8_t(Action::BtfPosP) + sr), last ? State::Stopping : State::SbWait);
			return finishSegment();
		}
		if (state == State::Rx)
		{
			// method 2: three bytes left, DataN-2 in DR, DataN-1 in the shift register
			if (length - index != 3) return unexpected(BTF);
			__disable_irq();
			r->CR1 &= ~I2C_CR1_ACK;
			rbuf[index++] = r->DR;
			end(last);
			rbuf[index++] = r->DR;
			__enable_irq();
			buffer(true);
			return go(before, BTF, Action(uint8_t(Action::BtfEndP) + sr), State::RxEnd);
		}
		if (state != State::Tx) return unexpected(BTF);
		if (index < length or more())
		{
			r->DR = wbuf[index++];
			buffer(index < length or next == Operation::Write);
			return go(before, BTF, Action::Write, State::Tx);
		}
		// more() may have fetched buffers: the operation after this one is `next` now
		const bool stop = next == Operation::Stop;
		end(stop); buffer(false);
		go(before, BTF, Action(uint8_t(Action::EndTxP) + (stop ? 0 : 1)), stop ? State::Stopping : State::SbWait);
		return finishSegment();
	}
	if (buf and (sr1 & I2C_SR1_TXE) and state == State::Tx)
	{
		if (index >= length and not more()) { buffer(false); return; }	// wait for BTF
		r->DR = wbuf[index++];
		buffer(index < length or next == Operation::Write);
		return go(before, TXE, Action::Write, State::Tx);
	}
}

void
I2cMasterBase::begin()
{
	I2C_TypeDef *const r = regs();
	active = true;
	error = Error::NoError;
	if (state == State::Stopping)
	{
		// the previous STOP first: a START queued behind a STOP can break (ES096 2.8.4)
		for (int us = 0; us < 200 and (r->CR1 & I2C_CR1_STOP); us++) modm::delay_us(1);
		go(State::Stopping, POLL, Action::None, State::Idle);
	}
	if (r->SR2 & I2C_SR2_BUSY)
	{
		for (int us = 0; us < 1000 and (r->SR2 & I2C_SR2_BUSY); us++) modm::delay_us(1);
		if (r->SR2 & I2C_SR2_BUSY)
		{
			// SWRST does not release a device that holds SDA: the bus clear (busy waits)
			hwReset();
			if ((r->SR2 & I2C_SR2_BUSY) and recoverBus) { recoverBus(false); hwReset(); }
			go(State::Idle, BUSY_AT_START, Action::Reset, State::Idle);
			if (r->SR2 & I2C_SR2_BUSY) { error = Error::BusBusy; return detach(DetachCause::ErrorCondition); }
		}
	}
	if (not segment(transaction->starting())) return refuse();
	go(State::Idle, START, Action::Start, State::SbWait);
	r->CR2 = (r->CR2 & ~I2C_CR2_ITBUFEN) | I2C_CR2_ITEVTEN | I2C_CR2_ITERREN;
	r->CR1 = (r->CR1 & ~I2C_CR1_POS) | I2C_CR1_ACK | I2C_CR1_START;
}

bool
I2cMasterBase::segment(I2cTransaction::Starting s)
{
	address = s.address & 0xfe;
	return fetch(Operation(s.next));
}

// a write buffer that is used up while the transaction has another one
bool
I2cMasterBase::more()
{
	while (index >= length and next == Operation::Write)
		if (not fetch(Operation::Write)) return false;
	return index < length;
}

// the segment is over (STOP or START requested): the transaction is detached at its STOP,
// at a Restart the next segment is fetched now, its START is already programmed
void
I2cMasterBase::finishSegment()
{
	if (next == Operation::Stop)
		return detach((error == Error::NoError) ? DetachCause::NormalStop : DetachCause::ErrorCondition);
	const auto s = transaction->starting();
	if (not segment(s))
	{
		// a read of nothing, refused after its repeated START is requested: the device is
		// addressed for writing and the transfer ends with STOP (a ping), then fails
		error = Error::Unknown;
		address = s.address & 0xfe; reading = false; length = index = 0; next = Operation::Stop;
	}
}

// the first segment is refused, before its START
void
I2cMasterBase::refuse()
{
	go(state, START, Action::Unexpected, State::Idle);
	error = Error::Unknown;
	if (state != State::Idle) hwReset();
	detach(DetachCause::ErrorCondition);
}

%% endif
} // namespace modm::platform
